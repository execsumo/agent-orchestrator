# AO_ACP_RUNTIME_DIR or AO_CLAUDE_ACP_COMMAND must be set for the orchestrator's chat driver.
# Example:
# AO_ACP_RUNTIME_DIR=/path/to/acp/runtime

# Bind LAN listener to loopback so tailscale serve is the only path in.
AO_CONNECT_BIND_HOST=127.0.0.1

# Allow the SPA's own tailnet origin, or the browser gets 403 ORIGIN_FORBIDDEN
# on every module script (blank page). Must match the served URL exactly.
AO_ALLOWED_ORIGINS=https://vibebox.goose-marlin.ts.net:8443

# Ensure a port conflict fails loudly instead of silently drifting.
AO_CONNECT_STRICT_PORT=1

# Tailnet Identity trust (Optional)
# Enables password-free login when behind tailscale serve.
# AO_CONNECT_TRUST_TAILSCALE_IDENTITY=1

# [HUMAN REQUIRED] Set the exact value of allowed logins here. Leave empty to deny everyone.
# Example:
# AO_CONNECT_ALLOWED_LOGINS="execsumo@github"
